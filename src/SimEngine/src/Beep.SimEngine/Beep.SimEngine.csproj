<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.1: a plain library any .NET host can load. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Beep.SimEngine</AssemblyName>
    <RootNamespace>Beep.SimEngine</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- No references at all: no platform, no NuGet. The framework is plain C#. -->
</Project>
