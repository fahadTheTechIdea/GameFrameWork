{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimpleRTS normalized scenario pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest",
    "documents"
  ],
  "properties": {
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "documents": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/path"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/scenario"
          },
          {
            "$ref": "#/$defs/zone"
          },
          {
            "$ref": "#/$defs/objective"
          },
          {
            "$ref": "#/$defs/ending"
          },
          {
            "$ref": "#/$defs/localization"
          }
        ]
      }
    },
    "abstractCases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/abstractCase"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_.-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "path": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[a-zA-Z0-9_/-]+\\.json$"
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fact",
            "op",
            "value"
          ],
          "properties": {
            "fact": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9_.-]{0,127}$"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "maxLength": 4096
                }
              ]
            }
          }
        }
      ]
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "arguments"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_.-]{0,127}$"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "arguments": {
          "type": "object",
          "maxProperties": 8
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentApiVersion",
        "packId",
        "packVersion",
        "gameLayerId",
        "gameLayerVersion",
        "trustTier",
        "entryScenarioIds",
        "dependencies",
        "files"
      ],
      "properties": {
        "contentApiVersion": {
          "const": 1
        },
        "packId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9.-]+$"
        },
        "packVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "gameLayerId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "gameLayerVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "trustTier": {
          "const": "data_only"
        },
        "entryScenarioIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "packId",
              "packVersion"
            ],
            "properties": {
              "packId": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9_.-]{0,127}$"
              },
              "packVersion": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              }
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "kind"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "kind": {
                "enum": [
                  "scenario",
                  "zone",
                  "objective",
                  "ending",
                  "localization"
                ]
              }
            }
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contentApiVersion",
        "id",
        "titleKey",
        "startZoneId",
        "zoneIds",
        "objectiveIds",
        "endingIds",
        "closingCondition",
        "layerData"
      ],
      "properties": {
        "kind": {
          "const": "scenario"
        },
        "contentApiVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "titleKey": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_.-]{0,127}$"
        },
        "startZoneId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "zoneIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "objectiveIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "endingIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "closingCondition": {
          "$ref": "#/$defs/condition"
        },
        "layerData": {
          "type": "object"
        }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contentApiVersion",
        "id",
        "titleKey",
        "sceneRole",
        "anchors",
        "exits"
      ],
      "properties": {
        "kind": {
          "const": "zone"
        },
        "contentApiVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "titleKey": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_.-]{0,127}$"
        },
        "sceneRole": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "positionMm"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "positionMm": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": -10000000,
                  "maximum": 10000000
                }
              }
            }
          }
        },
        "exits": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "targetZoneId",
              "anchorId",
              "condition",
              "durationTicks"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "targetZoneId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "anchorId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "condition": {
                "$ref": "#/$defs/condition"
              },
              "durationTicks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 12000
              }
            }
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contentApiVersion",
        "id",
        "titleKey",
        "dependencies",
        "activateWhen",
        "completeWhen",
        "failWhen",
        "successEffects",
        "failureEffects"
      ],
      "properties": {
        "kind": {
          "const": "objective"
        },
        "contentApiVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "titleKey": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_.-]{0,127}$"
        },
        "dependencies": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objectiveId",
              "acceptedStatuses"
            ],
            "properties": {
              "objectiveId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "acceptedStatuses": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "Completed",
                    "Failed",
                    "Abandoned"
                  ]
                }
              }
            }
          }
        },
        "activateWhen": {
          "$ref": "#/$defs/condition"
        },
        "completeWhen": {
          "$ref": "#/$defs/condition"
        },
        "failWhen": {
          "$ref": "#/$defs/condition"
        },
        "successEffects": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "failureEffects": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    },
    "ending": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contentApiVersion",
        "id",
        "titleKey",
        "summaryKey",
        "priority",
        "condition",
        "outcomeTags"
      ],
      "properties": {
        "kind": {
          "const": "ending"
        },
        "contentApiVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "titleKey": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_.-]{0,127}$"
        },
        "summaryKey": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_.-]{0,127}$"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "outcomeTags": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contentApiVersion",
        "id",
        "locale",
        "entries"
      ],
      "properties": {
        "kind": {
          "const": "localization"
        },
        "contentApiVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "entries": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_.-]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "abstractCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "facts",
        "expectedEnding"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "facts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_.-]{0,127}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 4096
              }
            ]
          }
        },
        "expectedEnding": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
