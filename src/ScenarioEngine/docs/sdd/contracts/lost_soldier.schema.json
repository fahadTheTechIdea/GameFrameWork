{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lost Soldier scenario layerData API 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "startingParty",
    "startingHeat",
    "resources",
    "actors",
    "contacts",
    "initialRoutes",
    "capturePolicy",
    "deadlineTicks",
    "interactions",
    "aiProfiles"
  ],
  "properties": {
    "startingParty": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "uniqueItems": true
    },
    "startingHeat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ammunition",
        "medical",
        "sustainment",
        "tools"
      ],
      "properties": {
        "ammunition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "medical": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "sustainment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "tools": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "zoneId",
          "spawnAnchorId",
          "condition",
          "aiProfileId",
          "weaponProfile"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "role": {
            "enum": [
              "lead",
              "companion",
              "sentry",
              "patrol",
              "officer",
              "civilian"
            ]
          },
          "zoneId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "spawnAnchorId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "condition": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "aiProfileId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "weaponProfile": {
            "enum": [
              "none",
              "rifle",
              "pistol",
              "automatic"
            ]
          }
        }
      }
    },
    "contacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "actorId",
          "trust"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "actorId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "trust": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "initialRoutes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boat",
        "ferry"
      ],
      "properties": {
        "boat": {
          "type": "boolean"
        },
        "ferry": {
          "type": "boolean"
        }
      }
    },
    "capturePolicy": {
      "enum": [
        "terminal",
        "recoverable"
      ]
    },
    "deadlineTicks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "interactions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "zoneId",
          "targetAnchorId",
          "actionType",
          "durationTicks",
          "costs",
          "requires",
          "completionResult"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "zoneId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "targetAnchorId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "actionType": {
            "enum": [
              "recover",
              "repair",
              "trade",
              "report",
              "treat",
              "escort",
              "rest"
            ]
          },
          "durationTicks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12000
          },
          "costs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ammunition",
              "medical",
              "sustainment",
              "tools"
            ],
            "properties": {
              "ammunition": {
                "type": "integer",
                "minimum": 0,
                "maximum": 24
              },
              "medical": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "sustainment": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "tools": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            }
          },
          "requires": {
            "type": "array",
            "minItems": 0,
            "maxItems": 16,
            "items": {
              "enum": [
                "lost_soldier.radioRecovered",
                "lost_soldier.missionDelivered",
                "lost_soldier.atFriendly",
                "lost_soldier.leadDead",
                "lost_soldier.leadCaptured",
                "lost_soldier.returnWindowClosed",
                "lost_soldier.companionLost",
                "lost_soldier.boatReady",
                "lost_soldier.ferryReady"
              ]
            }
          },
          "completionResult": {
            "enum": [
              "radio_recovered",
              "boat_ready",
              "ferry_ready",
              "mission_delivered",
              "contact_rescued",
              "rested",
              "treated"
            ]
          }
        }
      }
    },
    "aiProfiles": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "zoneId",
          "initialState",
          "patrolAnchorIds",
          "sightRangeMm",
          "reportDelayTicks",
          "memoryTicks",
          "communicationGroup",
          "ammoUnits"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "zoneId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "initialState": {
            "enum": [
              "patrol",
              "guard"
            ]
          },
          "patrolAnchorIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          },
          "sightRangeMm": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 100000
          },
          "reportDelayTicks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1200
          },
          "memoryTicks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12000
          },
          "communicationGroup": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "ammoUnits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  },
  "x-facts": {
    "lost_soldier.heat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "lost_soldier.radioRecovered": {
      "type": "boolean"
    },
    "lost_soldier.missionDelivered": {
      "type": "boolean"
    },
    "lost_soldier.atFriendly": {
      "type": "boolean"
    },
    "lost_soldier.leadDead": {
      "type": "boolean"
    },
    "lost_soldier.leadCaptured": {
      "type": "boolean"
    },
    "lost_soldier.returnWindowClosed": {
      "type": "boolean"
    },
    "lost_soldier.companionLost": {
      "type": "boolean"
    },
    "lost_soldier.boatReady": {
      "type": "boolean"
    },
    "lost_soldier.ferryReady": {
      "type": "boolean"
    }
  },
  "x-effects": {
    "lost_soldier.addTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contactId",
        "amount"
      ],
      "properties": {
        "contactId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "amount": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        }
      }
    },
    "lost_soldier.unlockRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeId"
      ],
      "properties": {
        "routeId": {
          "enum": [
            "boat",
            "ferry"
          ]
        }
      }
    },
    "lost_soldier.addSupply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "amount"
      ],
      "properties": {
        "resourceId": {
          "enum": [
            "ammunition",
            "medical",
            "sustainment",
            "tools"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "lost_soldier.recordOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      }
    }
  },
  "x-asset-roles": [
    "zone_orchard",
    "zone_farm",
    "zone_river",
    "zone_friendly_lines"
  ]
}
