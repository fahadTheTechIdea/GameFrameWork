{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campaign, run and profile progression proposed definition",
  "description": "Standalone design contract; current ScenarioEngine loading support is not implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "definitionVersion",
    "scope",
    "allowedDeltaKinds",
    "nextScenarioIds",
    "resetPolicy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "maxLength": 64
    },
    "definitionVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "scope": {
      "type": "string",
      "enum": [
        "campaign",
        "run",
        "profile"
      ],
      "description": "The reset and persistence boundary for this aggregate."
    },
    "allowedDeltaKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
        "maxLength": 64
      },
      "description": "Only registered typed deltas can cross a scenario boundary."
    },
    "nextScenarioIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
        "maxLength": 64
      },
      "description": "Validated destinations; no arbitrary path or script."
    },
    "resetPolicy": {
      "type": "string",
      "enum": [
        "explicit_new_lineage"
      ],
      "description": "Restart/new campaign creates a distinct lineage."
    }
  }
}
