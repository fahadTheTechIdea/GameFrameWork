{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tactical campaign layer proposed definition",
  "description": "Standalone design contract; current ScenarioEngine loading support is not implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "definitionVersion",
    "operationIds",
    "strategicActivityIds",
    "rosterCapacity",
    "failurePolicy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "maxLength": 64
    },
    "definitionVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "operationIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
        "maxLength": 64
      },
      "description": "Validated next-operation identities."
    },
    "strategicActivityIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
        "maxLength": 64
      },
      "description": "Campaign time jobs owned by activities."
    },
    "rosterCapacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256,
      "description": "Logical personnel capacity, not active native body count."
    },
    "failurePolicy": {
      "type": "string",
      "enum": [
        "authored_fail_forward",
        "campaign_end"
      ],
      "description": "Declare which losses permit continuation."
    }
  }
}
