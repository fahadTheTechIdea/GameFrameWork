{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acknowledged world requests and transitions proposed definition",
  "description": "Standalone design contract; current ScenarioEngine loading support is not implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "definitionVersion",
    "requestKinds",
    "maxPending",
    "deadlineUnits",
    "freezeScope"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "maxLength": 64
    },
    "definitionVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
        "maxLength": 64
      },
      "description": "Each kind needs both request and result schemas."
    },
    "maxPending": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256,
      "description": "Admission bound per session."
    },
    "deadlineUnits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "description": "Logical deadline for requests whose rule clock is advancing."
    },
    "freezeScope": {
      "type": "string",
      "enum": [
        "context",
        "region",
        "world"
      ],
      "description": "Only declared scope is frozen while native preparation runs."
    }
  }
}
