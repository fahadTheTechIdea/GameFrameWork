{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Narrative adventure layer proposed definition",
  "description": "Standalone design contract; current ScenarioEngine loading support is not implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "definitionVersion",
    "locationIds",
    "startLocation",
    "interactionIds",
    "completionScope"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "maxLength": 64
    },
    "definitionVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "locationIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
        "maxLength": 64
      },
      "description": "Declared locations with validated exit and interaction references."
    },
    "startLocation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "maxLength": 64,
      "description": "Must be in locationIds."
    },
    "interactionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
        "maxLength": 64
      },
      "description": "Referenced narrative/activity definitions."
    },
    "completionScope": {
      "type": "string",
      "enum": [
        "operation",
        "chapter"
      ],
      "description": "Close only the selected adventure scope."
    }
  }
}
