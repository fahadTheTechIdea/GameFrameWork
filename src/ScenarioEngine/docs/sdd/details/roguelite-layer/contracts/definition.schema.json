{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roguelite run and meta-progression layer proposed definition",
  "description": "Standalone design contract; current ScenarioEngine loading support is not implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "definitionVersion",
    "encounterIds",
    "runResourceIds",
    "profileUnlockIds",
    "deathPolicy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "maxLength": 64
    },
    "definitionVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "encounterIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
        "maxLength": 64
      },
      "description": "Registered encounter variants selected by a saved manifest."
    },
    "runResourceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
        "maxLength": 64
      },
      "description": "These quantities reset with the run."
    },
    "profileUnlockIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
        "maxLength": 64
      },
      "description": "Only declared permanent unlocks cross the result boundary."
    },
    "deathPolicy": {
      "type": "string",
      "enum": [
        "end_run",
        "authored_recovery"
      ],
      "description": "Explicit result/reset rule."
    }
  }
}
