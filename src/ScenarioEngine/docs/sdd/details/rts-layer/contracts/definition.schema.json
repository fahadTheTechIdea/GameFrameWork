{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTS and base-defence layer proposed definition",
  "description": "Standalone design contract; current ScenarioEngine loading support is not implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "definitionVersion",
    "unitDefinitionIds",
    "maxGroupSelection",
    "productionIds",
    "activeActorBudget"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "maxLength": 64
    },
    "definitionVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "unitDefinitionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
        "maxLength": 64
      },
      "description": "Registered movement/combat/resource policies."
    },
    "maxGroupSelection": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128,
      "description": "Bounded group intent; one command does not mean one native frame per unit."
    },
    "productionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
        "maxLength": 64
      },
      "description": "Activity definitions with reserved inputs and capacity."
    },
    "activeActorBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024,
      "description": "A proposed measured tier, not shipping capacity."
    }
  }
}
